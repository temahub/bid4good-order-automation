{
  "trailingComma": "none",
  "plugins": ["prettier-plugin-apex", "@prettier/plugin-xml"],
  "tabWidth": 2,
  "printWidth": 120,
  "overrides": [
    {
      "files": "**/*.cls",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "**/*.trigger",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": ["**/*.xml", "**/*.meta.xml"],
      "options": {
        "parser": "xml",
        "tabWidth": 2,
        "xmlSelfClosingSpace": false,
        "xmlWhitespaceSensitivity": "ignore"
      }
    },
    {
      "files": "**/lwc/**/*.js",
      "options": {
        "singleQuote": true,
        "printWidth": 80
      }
    },
    {
      "files": "**/lwc/**/*.html",
      "options": {
        "parser": "lwc",
        "printWidth": 120,
        "htmlWhitespaceSensitivity": "ignore",
        "bracketSameLine": true,
        "singleAttributePerLine": false
      }
    }
  ]
}
